{
    "name": "as2expert/as2expert",
    "description": "Official PHP client for the AS2Expert REST API (send/receive AS2/EDI, partners, certificates, stations, EDIFACT).",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["as2", "edi", "edifact", "b2b", "as2expert"],
    "homepage": "https://github.com/as2expert/as2expert-php",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10 || ^11"
    },
    "autoload": {
        "psr-4": {
            "As2Expert\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "As2Expert\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
